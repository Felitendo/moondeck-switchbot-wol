[Unit]
Description=MoonDeck SwitchBot login trigger (%i)
Documentation=man:moondeck-switchbot-wol(1)

[Service]
Type=oneshot
ExecStart=@LIBEXECDIR@/login-agent
StandardInput=socket
StandardOutput=socket
StandardError=journal
StateDirectory=moondeck-switchbot-wol
# A login waits for the session and then for Sunshine.
TimeoutStartSec=180

# It writes the display manager's config and restarts it, so it stays root.
# Nothing beyond that is needed.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
